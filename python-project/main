import csv
import sys
from urllib.parse import urljoin

import requests
from bs4 import BeautifulSoup


def over_argumenty() -> tuple[str, str]:
    if len(sys.argv) != 3:
        print(
            "Chyba: Nebyl zadán správný počet argumentů!\n"
            "Použití: python main.py <odkaz_na_okres> <nazev_souboru.csv>"
        )
        sys.exit(1)
    return sys.argv[1], sys.argv[2]


def stahni_html(url: str) -> BeautifulSoup:
    try:
        odpoved = requests.get(url)
        odpoved.raise_for_status()
    except requests.RequestException as chyba:
        print(f"Chyba při stahování dat z URL: {chyba}")
        sys.exit(1)
    return BeautifulSoup(odpoved.text, "html.parser")


def ziskej_seznam_obci(hlavni_soup: BeautifulSoup, hlavni_url: str) -> list[dict]:
    obce = []
    radky = hlavni_soup.find_all("tr")

    for radek in radky:
        vsechna_td = radek.find_all("td")

        if len(vsechna_td) < 3:
            continue

        td_kod = vsechna_td[0]
        odkaz_a = td_kod.find("a")
        
        if not odkaz_a:
            continue

        kod = odkaz_a.text.strip()
        relativni_odkaz = odkaz_a["href"]
        absolutni_odkaz = urljoin(hlavni_url, relativni_odkaz)
        
        nazev = vsechna_td[1].text.strip()

        if not nazev or nazev == "-":
            continue

        obce.append({"kod": kod, "nazev": nazev, "odkaz": absolutni_odkaz})

    return obce


def vyscrapuj_detail_obce(url_obce: str) -> dict:
    soup = stahni_html(url_obce)
    data = {}
    
    td_registered = soup.find("td", headers="sa1") or soup.find("td", headers="ps311_rb1")
    td_envelopes = soup.find("td", headers="sa2") or soup.find("td", headers="ps311_rb2")
    td_valid = soup.find("td", headers="sa3") or soup.find("td", headers="ps311_rb3")

    data["registered"] = td_registered.text.replace("\xa0", "").strip() if td_registered else "0"
    data["envelopes"] = td_envelopes.text.replace("\xa0", "").strip() if td_envelopes else "0"
    data["valid"] = td_valid.text.replace("\xa0", "").strip() if td_valid else "0"

    strany_data = {}
    
    for t_num in (1, 2):
        radky_stran = soup.find_all("tr")
        for radek in radky_stran:
            td_nazev = radek.find("td", headers=f"t{t_num}sa1" if t_num == 1 else f"t{t_num}sb1")
            td_hlasy = radek.find("td", headers=f"t{t_num}sa2" if t_num == 1 else f"t{t_num}sb3")
            
            if td_nazev and td_hlasy:
                nazev_strany = td_nazev.text.strip()
                if nazev_strany and nazev_strany != "-":
                    hlasy = td_hlasy.text.replace("\xa0", "").strip()
                    strany_data[nazev_strany] = hlasy

    data["strany"] = strany_data
    return data


def zapis_do_csv(nazev_souboru: str, data_obci: list) -> None:
    if not data_obci:
        print("Žádná data k zápisu.")
        return

    hlavicka = ["code", "location", "registered", "envelopes", "valid"]
    vsechny_strany = list(data_obci[0]["strany"].keys())
    hlavicka.extend(vsechny_strany)

    try:
        with open(nazev_souboru, mode="w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f, delimiter=";")
            writer.writerow(hlavicka)

            for obec in data_obci:
                radek = [
                    obec["kod"],
                    obec["nazev"],
                    obec["registered"],
                    obec["envelopes"],
                    obec["valid"],
                ]
                for strana in vsechny_strany:
                    radek.append(obec["strany"].get(strana, "0"))
                
                writer.writerow(radek)
    except IOError as chyba:
        print(f"Chyba při zápisu do CSV souboru: {chyba}")
        sys.exit(1)


def main() -> None:
    url, vystupni_csv = over_argumenty()
    
    print(f"STAHUJI DATA Z VYBRANÉHO URL: {url}")
    hlavni_soup = stahni_html(url)
    
    print("PROHLEDÁVÁM SEZNAM OBCÍ...")
    seznam_obci = ziskej_seznam_obci(hlavni_soup, url)
    
    vysledna_data = []
    print(f"Nalezeno obcí: {len(seznam_obci)}. Začínám scrapovat detaily...")
    
    for index, obec in enumerate(seznam_obci, 1):
        if index % 10 == 0 or index == len(seznam_obci):
            print(f"Zpracováno {index}/{len(seznam_obci)} obcí...")
            
        detail = vyscrapuj_detail_obce(obec["odkaz"])
        
        obec.update(detail)
        vysledna_data.append(obec)
        
    print(f"UKLÁDÁM DATA DO SOUBORU: {vystupni_csv}")
    zapis_do_csv(vystupni_csv, vysledna_data)
    print("HOTOVO! Projekt byl úspěšně dokončen. 🎉")


if __name__ == "__main__":
    main()
